NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=


# ---------------------------------------------------------------------------
# Outgoing mail: two separate mailboxes
# ---------------------------------------------------------------------------
#
# HR sends internal mail about people. Sales sends outward mail to customers
# and leads. They are deliberately different accounts: a customer replying to
# a campaign should reach sales, and a bulk campaign that upsets a provider
# must not stop a new employee getting their password.
#
# Which one each job uses is in src/lib/mail/accounts.ts.
#
# Port 465 turns TLS on. Any other port uses STARTTLS.

# --- HR mailbox: the user module -------------------------------------------
# Account created, welcome mail, password. Internal readers only.
#
# Each of these four falls back to its older unprefixed name at the bottom
# of this block when it is unset: HR_SMTP_HOST to SMTP_HOST, and so on. An
# existing deployment therefore keeps working untouched. Prefer these names.
HR_SMTP_HOST=
HR_SMTP_PORT=
HR_SMTP_USER=
HR_SMTP_PASS=

# The internal inbox told whenever a user is created. HR, not sales.
MAIL_TO=

# --- Sales mailbox: outward mail -------------------------------------------
# Email marketing campaigns, quotations, anything a customer or lead reads.
#
# There is no fallback to the HR account. If these are unset, sales mail
# fails and says which variable is missing. That is on purpose: sending a
# customer's quotation from the HR mailbox is the problem these variables
# exist to prevent.
#
# Bulk campaigns use these four as well. There is nothing else to set up:
# no SMTP form, nothing stored in the database, no password to re-enter.
# The send rate and the daily cap are constants in
# src/lib/email/config/deliveryConfig.ts. The only control on the settings
# screen is the kill switch, which stops all sending at once.
SALES_SMTP_HOST=
SALES_SMTP_PORT=
SALES_SMTP_USER=
SALES_SMTP_PASS=

# The older unprefixed SMTP_HOST, SMTP_PORT, SMTP_USER and SMTP_PASS are
# still read for any HR_SMTP_* value that is unset, so an environment that
# predates the split keeps working. Do not add them to a new one.


# The Mongo id of the system integration user: the bot account (role 90,
# "System Integration User") that leads arriving by themselves are written
# as. The booking page and the website integrations below use it as
# createdBy and as the activity log's actor. Required by both.
ZANSERVICES_USER_ID=

# Website integrations: the websites post leads to /api/integrations/leads
# and newsletter sign-ups to /api/integrations/newsletter, server to server.
# Each website has its own key, at least 32 characters, sent as
# "Authorization: Bearer <key>". Put the same value in that website's
# ZAN_WORKSPACE_API_KEY. The key decides which website a request is from,
# and so which regions it may write to: zanservices IN and US,
# zanverse-technologies AE. A website whose key is unset is refused, and
# the two keys must differ. Make one with: openssl rand -hex 32
# See docs/website-integrations.md.
ZANSERVICES_SITE_API_KEY=
ZANVERSE_TECHNOLOGIES_SITE_API_KEY=

# Optional — deployment region: IN, US or AE. Unset or unknown means IN.
# It sets the default phone country, the placeholder, and how old numbers
# without a country code are read. Match it to the database: never switch it
# on a database that already holds numbers without a country code.
# Build-time value: rebuild after changing it.
NEXT_PUBLIC_REGION=


# Firebase Cloud Messaging (push notifications).
# Firebase console → Project settings → General → Your apps → Config.
# These values are public. They are build-time values: rebuild after changing them.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Project settings → Cloud Messaging → Web Push certificates → Key pair.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Server only. Keep these secret. From the service account JSON file
# (Project settings → Service accounts → Generate new private key).
# The private key may be one line with \n for each line break.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Email marketing
# ---------------------------------------------------------------------------

# Campaigns send through the sales mailbox above. There is no separate
# connection to set up, nothing is stored in the database, and the send
# rate and daily cap are constants in
# src/lib/email/config/deliveryConfig.ts, not settings.
#
# The three secrets below are each just a long random string. Generate one
# with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"

# Signs the open-pixel and click-redirect tokens. Any long random string.
# Changing it stops old tracking links working. Existing counts are kept.
EMAIL_TRACKING_SECRET=

# Guards /api/jobs/email/* so only the scheduler can run the dispatcher and
# the worker. Any long random string. The scheduler sends it as
# `x-job-secret`.
EMAIL_JOB_SECRET=

# The origin the app uses to build tracking and unsubscribe links, and to
# call its own worker. Must be the public URL, not localhost, in production.
# Example: https://crm.zanservices.com
EMAIL_PUBLIC_ORIGIN=

# Which queue the dispatcher wakes workers through. "direct" is an HTTP
# call to our own worker route and needs no other service. That is the
# setting for the Vercel Hobby plan, where a campaign of up to 100
# recipients finishes inside one function invocation.
# See docs/EMAIL_MARKETING_DECISIONS.md.
EMAIL_QUEUE_ADAPTER=direct

# Signs the provider's bounce and delivery webhooks. Without it the
# webhook endpoint refuses every request, rather than running unguarded:
# it writes to the suppression list, so an open one would let anyone stop
# you emailing your own customers.
EMAIL_WEBHOOK_SECRET=
