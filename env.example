# Optional — calendar id (default "primary") and time zone (default "Asia/Kolkata")
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_TIMEZONE=
# Optional — inbox invited to every public booking (default sales@zanservices.com)
BOOKING_HOST_EMAIL=


IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=


SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_TO=


CLIENT_PORTAL_API_KEY=
CLIENT_PORTAL_ORIGIN=
ZANSERVICES_USER_ID=

# Optional — deployment region: IN, US or AE. Unset or unknown means IN.
# It sets the default phone country, the placeholder, and how old numbers
# without a country code are read. Match it to the database: never switch it
# on a database that already holds numbers without a country code.
# Build-time value: rebuild after changing it.
NEXT_PUBLIC_REGION=


# Firebase Cloud Messaging (push notifications).
# Firebase console → Project settings → General → Your apps → Config.
# These values are public. They are build-time values: rebuild after changing them.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Project settings → Cloud Messaging → Web Push certificates → Key pair.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Server only. Keep these secret. From the service account JSON file
# (Project settings → Service accounts → Generate new private key).
# The private key may be one line with \n for each line break.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=